# backend/.env.sample
# RecruiterRadar Backend Configuration
# Copy this file to .env and fill in your values

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
EMBEDDING_MODEL_NAME=text-embedding-3-small
CHAT_MODEL_NAME=gpt-4o-mini
MODEL_CHAT_TEMPERATURE=0.7
MODEL_CHAT_MAX_TOKENS=500
RESUME_SNIPPET_MAX_CHARS_FOR_PROMPT=3000

# Data Paths (use absolute paths for production)
CANDIDATE_DATA_FULL_PATH=/absolute/path/to/your/backend/app/data/candidate_profiles.json

# ChromaDB Configuration
CHROMA_DB_PATH=./app/data/chroma_db
CHROMA_COLLECTION_NAME=candidate_profiles

# API Configuration
APP_NAME=RecruiterRadar
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# CORS Settings (comma-separated origins)
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# Server Configuration
API_V1_STR=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# Future Features (not used in MVP but ready)
ENABLE_VARIATIONS=false
MAX_VARIATIONS=3